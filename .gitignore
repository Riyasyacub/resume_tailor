# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system.
.DS_Store
*.swp
*~
.idea/
.vscode/

# Never commit the master key — it decrypts config/credentials.yml.enc.
/config/master.key

# Databases. These hold parsed resume text and pasted job descriptions,
# so they are personal data as well as build artefacts.
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

# Logs and temporary files.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep

# Local environment overrides, which is where an API key would end up.
/.env
/.env.*
!/.env.example

# Compiled assets and dependencies.
/public/assets
/node_modules
/app/assets/builds/*
!/app/assets/builds/.keep

# An empty clone of the GitHub repo lives here; the app itself is this directory.
/resume_tailor/
